---
import Site from '../layouts/Site.astro';
import OpenApplet from '../components/OpenApplet.astro';
import { ABOUT, absoluteUrl, DECISIONS_URL, href, SITE_NAME } from '../lib/site';

const description =
  'kernl is a shell that runs small applets in a sealed sandbox. Your identity, contacts, messages and files stay yours; applets borrow them only while you watch.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'kernl',
    url: absoluteUrl(href('')),
    description,
    applicationCategory: 'Shell',
    operatingSystem: 'Web browser',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', name: 'kernl', price: '0.00', priceCurrency: 'USD', availability: 'https://schema.org/OnlineOnly', url: absoluteUrl(href('app/')) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'kernl',
    programmingLanguage: 'TypeScript',
    license: 'https://opensource.org/license/mit',
    url: DECISIONS_URL,
  },
];

const embedSample = `import { createKernl } from '@kernl/core';

const kernl = createKernl({ host });
const pointer = kernl.decodePointer(address);
const applet = await kernl.resolve(pointer);
kernl.mount(await kernl.plan(applet), frame);`;

const shellSample = `pnpm install && pnpm build
pnpm site:dev
# the shell is at localhost:4321/app/`;

const paths = [
  {
    who: 'You have an application',
    title: 'Add applets to it',
    summary: 'Your page stays yours. kernl takes one frame inside it and holds everything that frame can reach.',
    steps: [
      { name: 'Set the frame policy.', detail: 'One line in your page head, so an applet frame can only ever show verified code.' },
      { name: 'Describe your app as a host.', detail: 'Six members tell kernl how your app stores, asks for consent, notifies and opens links.' },
      { name: 'Mount an applet.', detail: 'Resolve it by address, ask the person what to grant, and hand kernl a frame you own.' },
    ],
    sample: embedSample,
    primary: { label: 'Embed kernl in a page', path: 'docs/tutorials/embed-a-host-page' },
    secondary: { label: 'The short version', path: 'docs/how-tos/embed-kernl-core' },
  },
  {
    who: 'You are starting a shell',
    title: 'Begin with ours',
    summary: 'The shell at /app/ is one host built on the same core. Run it, change what you disagree with, and ship it.',
    steps: [
      { name: 'Run it.', detail: 'Install, build and start the site. The shell comes up with the guard already strict.' },
      { name: 'Make it yours.', detail: 'Choose the starting guard profile, add messaging providers and bridge backends, pick a layout.' },
      { name: 'Ship it.', detail: 'One static build holds the site, the shell and the docs. There is no server to run.' },
    ],
    sample: shellSample,
    primary: { label: 'Run the shell', path: 'docs/tutorials/run-the-shell' },
    secondary: { label: 'Deploy it', path: 'docs/how-tos/deploy' },
  },
];

const previewHref = href('app/?preview=1');
---

<Site title={SITE_NAME} description={description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title" data-flow>
    <div class="wrap">
      <div class="hero-copy">
        <p class="label reveal">A shell for applets · alpha</p>
        <h1 id="hero-title" class="reveal">Run things you don't have to trust.</h1>
        <p class="lede reveal">
          kernl runs small applets in a sealed sandbox. <strong>Your identity, contacts, messages and files stay yours.</strong> An applet borrows them only with your say-so.
        </p>
        <p class="hero-actions reveal">
          <a class="button primary" href={previewHref} data-astro-reload>Try the preview</a> <a class="button" href="#adopt">Adopt kernl</a>
        </p>
        <p class="hero-hint reveal">No sign-up. The preview runs in this tab, with sample applets.</p>
      </div>
    </div>
  </section>

  <section class="section" id="adopt" aria-labelledby="adopt-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label">Adopt</p>
        <h2 id="adopt-title">Two ways in.</h2>
        <p class="lede">Add kernl to an application you already have, or start a shell of your own. Both run on the same four packages, with the same guard.</p>
      </div>
      <div class="grid cols-2">
        {paths.map((path) => (
          <article class="card path reveal">
            <p class="label">{path.who}</p>
            <h3>{path.title}</h3>
            <p>{path.summary}</p>
            <ol class="path-steps">
              {path.steps.map((step) => (
                <li><span><strong>{step.name}</strong> {step.detail}</span></li>
              ))}
            </ol>
            <pre><code>{path.sample}</code></pre>
            <p class="path-links">
              <a class="button primary" href={href(path.primary.path)} data-astro-reload>{path.primary.label}</a> <a href={href(path.secondary.path)} data-astro-reload>{path.secondary.label}</a>
            </p>
          </article>
        ))}
      </div>
      <div class="adopt-notes reveal">
        <p class="note">kernl is alpha software. The packages are not in a public registry yet and the source opens with the first public release, so today both paths start from a copy of the source. The tutorials and <a href={DECISIONS_URL}>the decisions</a> are public now.</p>
        <p>Writing an applet instead? It needs no kernl code at all. <a href={href(`${ABOUT}developers/`)}>See what your applet gets.</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="open-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label">Open an applet</p>
        <h2 id="open-title">Already have an address?</h2>
        <p class="lede">Open it in the shell. kernl checks the applet's code against its address before anything runs.</p>
      </div>
      <div class="reveal">
        <OpenApplet />
      </div>
      <p class="more reveal"><a class="button" href={href(ABOUT)}>What kernl is, and why</a></p>
    </div>
  </section>
</Site>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    /* The header is 3.75rem and a 1px rule; the hero takes exactly what is left of the first screen. */
    min-height: calc(100svh - 3.75rem - 1px);
    padding-block: clamp(1.5rem, 5vh, 4rem);
  }

  /* The rail the stage draws, as a still line: what the hero shows without scripts, WebGL or motion. */
  .hero::after {
    content: '';
    position: absolute;
    inset-block: 14%;
    right: 8px;
    width: 1px;
    background: linear-gradient(transparent, var(--accent), transparent);
    opacity: 0.7;
    pointer-events: none;
  }

  :global(.stage[data-live] ~ main) .hero::after {
    opacity: 0;
  }

  @media (min-width: 960px) {
    .hero::after {
      right: 35%;
    }
  }

  .hero-copy {
    display: grid;
    gap: clamp(0.9rem, 2.4vh, 1.4rem);
    max-width: 40rem;
  }

  .hero-copy > * {
    margin: 0;
  }

  /* The copy stops short of the rail, which stands at 65% of the screen. */
  @media (min-width: 960px) {
    .hero-copy {
      max-width: min(40rem, calc(65vw - var(--gutter) - 2.5rem));
    }
  }

  .hero h1 {
    font-size: clamp(2.5rem, min(7.5vw, 11.5vh), 5.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 0.4rem;
  }

  .hero-hint {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  #adopt {
    scroll-margin-top: 3.75rem;
  }

  .path {
    gap: 0.9rem;
    min-width: 0;
  }

  .path-steps {
    counter-reset: step;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
  }

  .path-steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .path-steps li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    padding-top: 0.15rem;
  }

  .path-steps strong {
    color: var(--ink);
    font-weight: 600;
  }

  .path pre {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) / 2);
    background: var(--bg-sunken);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .path pre code {
    font-size: inherit;
  }

  .path-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--ink);
  }

  .path-links a:not(.button) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .adopt-notes {
    display: grid;
    gap: 1rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--ink-muted);
  }

  .adopt-notes p {
    margin: 0;
    max-width: 46rem;
  }

  .more {
    margin: 2rem 0 0;
  }
</style>
