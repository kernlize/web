---
import Site from '../../../layouts/Site.astro';
import { href } from '../../../lib/site';

const description =
  'kernl describes several private-message providers and ranks none. Each is described by what it protects. Private, legacy and ratchet messages work in the live shell when your account can encrypt; ratchet sessions are experimental.';

interface Provider {
  name: string;
  summary: string;
  rows: readonly [string, string, 'on' | 'off' | 'mid'][];
}

const providers: readonly Provider[] = [
  {
    name: 'Private messages',
    summary: 'The default. Each message is meant to be wrapped so the network cannot see who wrote it or what it says.',
    rows: [
      ['Forward secrecy', 'No', 'off'],
      ['Heals after a key leak', 'No', 'off'],
      ['Metadata protection', 'Partial', 'mid'],
      ['Other person needs this app', 'No', 'on'],
      ['Groups', 'Yes', 'on'],
      ['Experimental', 'No', 'on'],
    ],
  },
  {
    name: 'Legacy messages',
    summary: 'The original format, kept so old conversations still open. The content is hidden; who talks to whom and when is not.',
    rows: [
      ['Forward secrecy', 'No', 'off'],
      ['Heals after a key leak', 'No', 'off'],
      ['Metadata protection', 'None', 'off'],
      ['Other person needs this app', 'No', 'on'],
      ['Groups', 'No', 'off'],
      ['Experimental', 'No', 'on'],
    ],
  },
  {
    name: 'Ratchet sessions',
    summary: 'Keys change with every message, so a leak today does not expose yesterday. Both sides need an app that speaks it.',
    rows: [
      ['Forward secrecy', 'Yes', 'on'],
      ['Heals after a key leak', 'Yes', 'on'],
      ['Metadata protection', 'Partial', 'mid'],
      ['Other person needs this app', 'Yes', 'off'],
      ['Groups', 'No', 'off'],
      ['Experimental', 'Yes', 'off'],
    ],
  },
  {
    name: 'Group sessions',
    summary: 'A group shares keys that change as it talks and as people join or leave, so a leak exposes neither what came before nor, once the group moves on, what comes after. Everyone in it needs an app that speaks it.',
    rows: [
      ['Forward secrecy', 'Yes', 'on'],
      ['Heals after a key leak', 'Yes', 'on'],
      ['Metadata protection', 'Partial', 'mid'],
      ['Other person needs this app', 'Yes', 'off'],
      ['Groups', 'Yes', 'on'],
      ['Experimental', 'Yes', 'off'],
    ],
  },
];
---

<Site title="Messaging" description={description}>
  <section class="section" aria-labelledby="msg-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Messaging</p>
        <h1 id="msg-title">Described, not ranked.</h1>
        <p class="lede">kernl is built to offer private messaging through several providers. <strong>None of them is "the best".</strong> The shell tells you plainly what each one protects, and you pick the one the person you are writing to can read.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="status-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label">Where it stands</p>
        <h2 id="status-title">Two providers send today; one is still to come.</h2>
      </div>
      <div class="note reveal">
        <p>kernl is alpha software. Private messages and legacy messages work in the live shell once you sign in with an account that can encrypt: a browser extension, a remote signer or a local account on this device. A read-only account cannot, and the shell says so. Ratchet sessions work the same way and are experimental: the person you write to needs an app that speaks them, they are one to one, and the keys that change with every message are kept on this device, locked so only your account can open them. Clearing this site's data ends those sessions. Group sessions work the same way and are experimental too: everyone you add needs an app that speaks them and must have used it once, so that you can invite them; your groups are kept on this device, locked to your account, while their messages last only until you reload. The <a href={href('app/?preview=1')}>preview</a> lets you try private and legacy messages without an account, and keeps everything in your browser tab; ratchet sessions need the live shell.</p><p>Your messages are opened by your own account, in the Messages panel, for you. An applet sees your messages only if you grant it messages, and you can take that grant back.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="providers-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label">Providers</p>
        <h2 id="providers-title">The same six questions, asked of each.</h2>
      </div>
      <div class="grid cols-3">
        {providers.map((provider) => (
          <article class="card reveal">
            <h3>{provider.name}</h3>
            <p>{provider.summary}</p>
            <dl class="props">
              {provider.rows.map(([term, value, tone]) => (
                <div>
                  <dt>{term}</dt>
                  <dd><span class:list={['pill', tone === 'on' && 'on', tone === 'off' && 'off']}>{value}</span></dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="terms-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="label">The words</p>
        <h2 id="terms-title">What the rows mean.</h2>
      </div>
      <dl class="terms reveal">
        <div><dt>Forward secrecy</dt><dd>If your keys leak today, messages from before today stay unreadable.</dd></div>
        <div><dt>Heals after a key leak</dt><dd>Once both of you keep writing, a leaked key stops being useful to whoever has it.</dd></div>
        <div><dt>Metadata protection</dt><dd>How much someone watching the network learns about who talks to whom and when. "Partial" means the sender and timing are hidden but delivery is not.</dd></div>
        <div><dt>Other person needs this app</dt><dd>Whether your correspondent must use an app that speaks the same provider.</dd></div>
        <div><dt>Experimental</dt><dd>The provider is still changing and may lose history between versions. kernl says so before you enable it.</dd></div>
      </dl>
      <div class="note reveal">
        <p>Applets are given one messaging surface that spans every provider you enable. The choice of provider stays with you, is shown on every conversation, and can be changed. More in the <a href={href('docs/')}>documentation</a>.</p>
      </div>
    </div>
  </section>
</Site>

<style>
  .terms {
    display: grid;
    gap: 1rem;
    margin: 0 0 2rem;
  }

  .terms > div {
    display: grid;
    gap: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .terms > div {
      grid-template-columns: 16rem 1fr;
      gap: 2rem;
    }
  }

  .terms dt {
    font-weight: 600;
  }

  .terms dd {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
