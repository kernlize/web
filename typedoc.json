{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/guard",
    "packages/messaging",
    "packages/bridges",
    "packages/kernel",
    "packages/modules",
    "packages/core",
    "packages/ui-model"
  ],
  "out": "docs/api",
  "name": "kernl API",
  "readme": "none",
  "treatWarningsAsErrors": true,
  "excludeExternals": true,
  "skipErrorChecking": false,
  "packageOptions": {
    "disableSources": true
  }
}
