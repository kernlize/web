{
  "name": "@kernlize/modules",
  "version": "0.1.0",
  "description": "kernl's modules over the kernel: messaging, bridges, downloads, uploads, the catalog, intents, multiplayer, people, profiles, mailboxes, the relay directory, the event cache, the theme, settings, social actions, keys and the window manager",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messaging/ratchet": {
      "types": "./dist/messaging/ratchet/index.d.ts",
      "import": "./dist/messaging/ratchet/index.js"
    },
    "./messaging/groups": {
      "types": "./dist/messaging/groups/index.d.ts",
      "import": "./dist/messaging/groups/index.js"
    },
    "./wm": {
      "types": "./dist/wm/index.d.ts",
      "import": "./dist/wm/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@internet-privacy/marmot-ts": "^0.9.0",
    "@kehto/nip": "^0.8.0",
    "@kehto/runtime": "^0.30.1",
    "@kehto/services": "^0.34.0",
    "@kehto/wm": "^0.0.2",
    "@kernlize/bridges": "workspace:^",
    "@kernlize/guard": "workspace:^",
    "@kernlize/kernel": "workspace:^",
    "@kernlize/messaging": "workspace:^",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "applesauce-accounts": "^7.1.0",
    "applesauce-common": "^7.1.1",
    "applesauce-core": "^7.1.3",
    "applesauce-loaders": "^7.2.0",
    "applesauce-relay": "^7.1.1",
    "applesauce-signers": "^7.1.0",
    "applesauce-sqlite": "^7.1.0",
    "blossom-client-sdk": "5.1.0",
    "nostr-double-ratchet": "^0.0.187",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@napplet/core": ">=0.41.0 <0.42.0",
    "@napplet/nap": ">=0.37.0 <0.41.0",
    "@napplet/shim": ">=0.30.0",
    "nostr-tools": ">=2.23.3 <=2.x"
  },
  "devDependencies": {
    "quickpickle": "^1.11.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernlize/web.git",
    "directory": "packages/modules"
  },
  "keywords": [
    "kernl",
    "shell",
    "applet",
    "view-model",
    "rxjs"
  ]
}
