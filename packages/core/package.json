{
  "name": "@kernlize/core",
  "version": "0.2.0",
  "description": "Opinionated shell composition over kehto and applesauce",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@internet-privacy/marmot-ts": "^0.9.0",
    "@kehto/acl": "^0.20.3",
    "@kehto/firewall": "^0.7.0",
    "@kehto/nip": "^0.8.0",
    "@kehto/runtime": "^0.28.0",
    "@kehto/services": "^0.30.1",
    "@kehto/shell": "^0.32.0",
    "@kehto/wm": "^0.0.2",
    "@kernlize/bridges": "workspace:^",
    "@kernlize/guard": "workspace:^",
    "@kernlize/messaging": "workspace:^",
    "applesauce-accounts": "^7.0.2",
    "applesauce-common": "^7.0.0",
    "applesauce-core": "^7.0.3",
    "applesauce-loaders": "^7.0.2",
    "applesauce-relay": "^7.0.0",
    "applesauce-signers": "^7.0.1",
    "nostr-double-ratchet": "^0.0.183",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@napplet/core": ">=0.38.0 <0.39.0",
    "@napplet/nap": ">=0.37.0 <0.38.0",
    "@napplet/shim": ">=0.30.0",
    "nostr-tools": ">=2.23.3 <=2.x"
  },
  "devDependencies": {
    "quickpickle": "^1.11.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernlize/web.git",
    "directory": "packages/core"
  },
  "keywords": [
    "kernl",
    "kehto",
    "shell",
    "applet",
    "core"
  ]
}
