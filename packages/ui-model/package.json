{
  "name": "@kernlize/ui-model",
  "version": "0.1.0",
  "description": "Framework-free view models for a kernl shell: the grants list, ask queues and logs as rxjs streams",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kernlize/core": "workspace:^",
    "@kernlize/guard": "workspace:^",
    "@kernlize/messaging": "workspace:^",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "quickpickle": "^1.11.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernlize/web.git",
    "directory": "packages/ui-model"
  },
  "keywords": [
    "kernl",
    "shell",
    "applet",
    "view-model",
    "rxjs"
  ]
}
