{
  "name": "@kernlize/preset",
  "version": "0.0.0",
  "private": true,
  "description": "kernl's own module list as a preset over the kernel",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kernlize/core": "workspace:^",
    "applesauce-core": "^7.1.3",
    "applesauce-relay": "^7.1.1"
  },
  "devDependencies": {
    "applesauce-signers": "^7.1.0",
    "quickpickle": "^1.11.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
